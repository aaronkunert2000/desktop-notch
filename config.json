{
  // Port des lokalen Endpunkts (nur localhost). notch_send.py nutzt NOTCH_PORT oder 47321.
  "port": 47321,
  // Globaler Hotkey: Quick Actions öffnen bzw. Insel auf-/zuklappen
  "hotkey": "Ctrl+Alt+N",
  // Demo-Events beim Start abspielen
  "demo": false,
  // Spotify anzeigen, solange Musik läuft
  "spotify": true,
  // WhatsApp-Benachrichtigungen übernehmen (experimentell); Preview = Nachrichtentext anzeigen
  "whatsApp": true,
  "whatsAppPreview": true,
  // Fokus-Timer in Minuten
  "focusMinutes": 25,
  "breakMinutes": 5,
  // Quick Action "Neue Notiz": Zielordner im Vault (leer = Button aus).
  // Persönliche Werte gehören in config.local.json (nicht im Repo), siehe README.
  "vaultInbox": "",
  // Quick Action "Claude": URI oder Programmpfad
  "claudeCommand": "claude://"
}
