<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 = Windows 10 2004+: nötig für die Windows-Mediensteuerung (Spotify) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms nur für das Tray-Icon -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Notch</RootNamespace>
    <AssemblyName>Notch</AssemblyName>
    <Version>1.1.0</Version>
    <Product>Desktop Notch</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Namenskonflikte WPF/WinForms vermeiden (Application, Button, Brush …) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\config.json" Link="config.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Persönliche Werte (nicht im Repo): nur mitkopieren, wenn vorhanden -->
    <None Include="..\..\config.local.json" Link="config.local.json" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\config.local.json')" />
  </ItemGroup>

</Project>
